# Settings for assistant-wakeup (docs/wakeup.md). Read by root only: it holds the token. Restart the service after
# editing: systemctl restart assistant-wakeup

# Shared secret for the HTTP endpoint. install.sh fills in a random one; whoever posts (n8n) sends
# "Authorization: Bearer <this>". Empty = the endpoint refuses everything.
WAKEUP_TOKEN=__TOKEN__

# Where the HTTP endpoint listens. 127.0.0.1 if n8n (or whatever posts) runs on the same machine. If it runs on
# another machine, listen on this machine's LAN address and open exactly that port to exactly that host.
WAKEUP_LISTEN=127.0.0.1:8770
# Addresses allowed to post, comma-separated (checked on top of the token).
WAKEUP_ALLOW=127.0.0.1

# Whose tmux session to type into (the assistant's user and the session name in assistant.env).
WAKEUP_USER=__USER__
WAKEUP_TMUX_SESSION=assistant
# WAKEUP_TMUX_SOCKET=/tmp/tmux-1000/default   # only if tmux uses a non-default socket

# Log files to watch: one rule per line in this file, "label | regex | /path/to/file.log".
WAKEUP_WATCH_FILE=/etc/assistant-wakeup.watch

# What arrives within this many seconds goes as one message (one turn).
WAKEUP_BATCH_SECONDS=8
WAKEUP_LOG=/var/log/assistant-wakeup.log
