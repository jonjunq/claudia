def npm_version(package):
    for root in ("/usr/local/lib/node_modules", "/usr/lib/node_modules"):
        js = jload(P(f"{root}/{package}/package.json"))
        if js and js.get("version"):
            return js["version"]
    return None


def c_browser(c):
    cfg = jload(c.H + "/.agent-browser/config.json") or {}
    exe = cfg.get("executablePath", "")
    miss = []
    if not (npm_version("agent-browser") or shutil.which("agent-browser")):
        miss.append("agent-browser")
    if exe and not os.path.exists(P(exe)):
        miss.append(exe)
    if not shutil.which("Xvfb") and not os.path.exists(P("/usr/bin/Xvfb")):
        miss.append("Xvfb")
    if miss:
        return R("fail", "missing: " + ", ".join(miss), asroot("assistant-setup install browser"), False)
    if not cfg or not os.path.isdir(c.H + "/.browser/clean"):
        return R("fail", "installed, but not set up for " + c.user, asroot("assistant-setup install browser"), True)
    if c.deep:
        rc, out = c.run(["sh", "-c", "agent-browser open about:blank >/dev/null && agent-browser eval navigator.userAgent;"
                         " agent-browser close >/dev/null 2>&1"], timeout=90)
        if rc != 0 or "Mozilla" not in out:
            return R("fail", "it does not start: " + out[-160:], "docs/browser.md (Install, and the GPU note)", True)
        if "HeadlessChrome" in out:
            return R("warn", "it starts, but as the headless shell that websites block", "docs/browser.md")
        return R("ok", "agent-browser " + (npm_version("agent-browser") or "") + "; opened a page with a full browser")
    return R("ok", "agent-browser " + (npm_version("agent-browser") or "") + " with a full browser")


def c_browser_window(c):
    off = [u for u in ("assistant-window-vnc", "assistant-window-web") if c.unit(u) is False]
    if off:
        return R("fail", "not enabled", asroot("assistant-setup install browser-window"), False)
    if not os.path.exists(P("/etc/assistant-window/vncpasswd")):
        return R("fail", "no window password", asroot("assistant-setup install browser-window"), True)
    if not os.path.exists(c.H + "/.config/assistant/window-link"):
        return R("warn", "running on this machine, but no link to reach it from the phone yet",
                 asroot("assistant-setup window-link <the address you reach it at>"))
    return R("ok", "running; the assistant has the link")


def wakeup_listen(c):
    listen = kv(P("/etc/assistant-wakeup.env")).get("WAKEUP_LISTEN") or "127.0.0.1:8770"
    host, _, port = listen.rpartition(":")
    return host or "127.0.0.1", int(port or 8770)


def c_wakeup(c):
    if c.unit("assistant-wakeup") is False:
        return R("fail", "not enabled", asroot("assistant-setup install wakeup"), False)
    if c.unit("assistant-wakeup", "is-active") is False:
        return R("fail", "enabled but not running", asroot("systemctl restart assistant-wakeup") + "; journalctl -u assistant-wakeup")
    host, port = wakeup_listen(c)
    try:
        socket.create_connection((host, port), 2).close()
    except OSError:
        return R("warn", f"running, but nothing answers on {host}:{port}", asroot("systemctl restart assistant-wakeup"))
    return R("ok", f"listening on {host}:{port}")


def c_idle_compact(c):
    if c.conf.get("IDLE_COMPACT") == "no":
        return R("skip", "turned off at install (IDLE_COMPACT=no)", "assistant-setup install idle-compact", False)
    if c.conf.get("IDLE_COMPACT") == "yes" and c.unit("assistant-idle-compact.timer") is not False:
        return R("ok", "on")
    return R("fail", "off", asroot("assistant-setup install idle-compact"), False)


def c_email_watch(c):
    if c.unit("n8n", "is-active"):
        return R("ok", "n8n is running; its email workflow is the assistant's to set up (n8n.md)")
    if os.path.exists(P("/usr/local/sbin/n8n-admin")) or os.path.exists(P("/etc/n8n.env")):
        return R("fail", "n8n is installed but not running", asroot("systemctl restart n8n") + "; journalctl -u n8n", True)
    return R("fail", "n8n is not installed", asroot("assistant-setup install email-watch"), False)


def skill_dirs(c):
    return glob.glob(c.H + "/.claude/skills/*/") + glob.glob(c.ws + "/.claude/skills/*/")


def c_diagrams(c):
    for d in skill_dirs(c):
        if os.path.basename(d.rstrip("/")) == "diagram-design" and os.path.exists(d + "SKILL.md"):
            return R("ok", "the diagram-design skill" + ("" if os.path.exists(d + ".installed-from") else
                                                         " (no .installed-from: the version watch cannot follow it)"))
    return R("fail", "not installed", "the assistant offers it when it fits (vetting-skills.md)", False)


def c_updates(c, watch):
    rw, how = c.conf.get("RELEASE_WATCH", ""), c.conf.get("RELEASE_WATCH_HOW", "")
    if rw == "no":
        return R("skip", "turned off at install (RELEASE_WATCH=no)", asroot("assistant-setup install updates"), False)
    if rw != "yes":
        return R("fail", "off", asroot("assistant-setup install updates"), False)
    if how == "n8n":
        if not c.unit("n8n", "is-active"):
            return R("fail", "the watch is an n8n workflow, and n8n is not running", asroot("systemctl restart n8n"))
    elif c.unit("assistant-release-watch.timer") is False:
        return R("fail", "the daily check (assistant-release-watch.timer) is off", asroot("assistant-setup install updates"))
    have = jload(P(SHARE + "/watch.json"))
    if not have:
        return R("fail", "no watch list yet", asroot("assistant-setup watch"), True)
    want = {w["id"] for w in watch if w["updates"] == "watch"}
    got = {w["id"] for w in have.get("watch", []) if w.get("updates") == "watch"}
    if want != got:
        bits = []
        if want - got:
            bits.append("not watched: " + ", ".join(sorted(want - got)))
        if got - want:
            bits.append("watched but not installed: " + ", ".join(sorted(got - want)))
        return R("fail", "; ".join(bits), asroot("assistant-setup watch"), True)
    return R("ok", f"{len(want)} things watched, every day ({'n8n' if how == 'n8n' else 'assistant-release-watch.timer'})")


CHECKS = {"system": c_system, "claude": c_claude, "workspace": c_workspace, "telegram": c_telegram,
          "telegram-extras": c_telegram_extras, "service": c_service, "nightly": c_nightly,
          "connectors": c_connectors, "voice": c_voice, "voice-local": c_voice_local, "pdf": c_pdf,
          "links-videos": c_links_videos, "browser": c_browser, "wakeup": c_wakeup, "updates": c_updates,
          "idle-compact": c_idle_compact, "voice-reply": c_voice_reply, "voice-backup": c_voice_backup,
          "voice-best": c_voice_best, "browser-window": c_browser_window, "email-watch": c_email_watch,
          "diagrams": c_diagrams}


# ---- what the version watch must cover ----

def version_of(text):
    m = re.search(r"(\d+(?:\.\d+){1,3})", text or "")
    return m.group(1) if m else None


def upstream_entry(c, cap, u):
    kind = u["kind"]
    e = {"name": u["name"], "what": u["what"], "kind": kind, "capabilities": [cap],
         "updates": {"auto": "auto", "system": "system"}.get(kind, "watch")}
    for k in ("repo", "package", "dist_tag", "plugin", "how"):
        if k in u:
            e[k] = u[k]
    if kind == "self":
        e["repo"] = c.conf.get("GITHUB_REPO", "")
        e["installed"] = c.conf.get("VERSION")
        e["id"] = "self:" + e["repo"]
    elif kind == "plugin":
        pdir, ver = plugin_dir(c)
        e["installed"] = ver
        name, _, market = u["plugin"].partition("@")
        for p in (f"/.claude/plugins/marketplaces/{market}/external_plugins/{name}/.claude-plugin/plugin.json",
                  f"/.claude/plugins/marketplaces/{market}/plugins/{name}/.claude-plugin/plugin.json"):
            js = jload(c.H + p)
            if js:
                e["latest"] = js.get("version")
                break
        e["id"] = "plugin:" + u["plugin"]
    elif kind == "pypi":
        e["installed"] = venv_version(c.tilde(u["venv"]), u["package"])
        e["id"] = "pypi:" + u["package"]
    elif kind == "npm":
        e["installed"] = npm_version(u["package"])
        e["id"] = "npm:" + u["package"]
    elif kind == "github":
        e["installed"] = version_of(c.run(u["version_cmd"], timeout=10)[1]) if "version_cmd" in u else None
        e["id"] = "github:" + u["repo"]
    elif kind == "skill":
        return None   # skills are found by their .installed-from (below), wherever they live
    else:
        e["id"] = kind + ":" + (u.get("repo") or re.sub(r"[^a-z0-9]+", "-", u["name"].lower()).strip("-"))
    return e


def watch_list(c, manifest, results):
    out = {}
    for cap in manifest["capabilities"]:
        if not results[cap["id"]]["installed"]:
            continue
        for u in cap.get("upstream", []):
            e = upstream_entry(c, cap["id"], u)
            if not e:
                continue
            if e["id"] in out:
                out[e["id"]]["capabilities"].append(cap["id"])
            else:
                out[e["id"]] = e
    # Third-party skills, installed by the assistant with a .installed-from (vetting-skills.md): repo= and commit=
    for d in skill_dirs(c):
        src = kv(d + ".installed-from")
        repo, commit = src.get("repo", ""), src.get("commit", "")
        if re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", repo) and re.fullmatch(r"[0-9a-f]{7,40}", commit):
            name = os.path.basename(d.rstrip("/"))
            sid = "skill:" + repo
            if sid not in out:
                out[sid] = {"id": sid, "name": name, "what": "a skill from " + repo, "kind": "skill", "repo": repo,
                            "installed": commit, "updates": "watch", "capabilities": ["diagrams"] if name == "diagram-design" else []}
    return sorted(out.values(), key=lambda e: e["id"])


def main():
    a = sys.argv[1:]
    if "--list-checks" in a:
        print("\n".join(CHECKS))
        return 0
    user = a[a.index("--user") + 1] if "--user" in a else None
    only = set(a[a.index("--only") + 1].split(",")) if "--only" in a else None
    wl = "--watch-list" in a
    c = Ctx(user, offline="--offline" in a or wl, deep="--deep" in a)
    manifest = find_manifest()
    results = {}
    for cap in manifest["capabilities"]:
        cid = cap["id"]
        fn = CHECKS.get(cid)
        if cid == "updates":
            continue
        try:
            r = fn(c) if fn else R("unknown", "this doctor has no check for it", "update the assistant")
        except Exception as e:  # a broken check must not hide the others
            r = R("unknown", "the check failed: " + str(e)[:120], "")
        results[cid] = r
    watch = watch_list(c, manifest, {k: results.get(k, {"installed": False}) for k in (x["id"] for x in manifest["capabilities"])})
    if wl:
        print(json.dumps(watch, indent=1))
        return 0
    results["updates"] = c_updates(c, watch)
    rows = []
    for cap in manifest["capabilities"]:
        cid = cap["id"]
        if cid not in results or (only and cid not in only):
            continue
        r = dict(results[cid])
        dec, when = c.decisions.get(cid, ("", ""))
        if r["status"] in ("fail", "unknown") and dec == "no":
            r.update(status="skip", detail="declined" + (" on " + when if when else ""))
        elif r["status"] == "fail" and cap["default"] in ("ask", "later") and dec != "yes":
            r.update(status="offer")
        rows.append({"id": cid, "group": cap["group"], "title": cap["title"], "default": cap["default"],
                     "needs": cap.get("needs", []), **r})
    summary = {s: sum(1 for r in rows if r["status"] == s) for s in SYMBOL}
    if "--json" in a:
        print(json.dumps({"user": c.user, "home": c.home, "version": c.conf.get("VERSION"), "offline": c.offline,
                          "checked_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "summary": summary,
                          "capabilities": rows}, indent=1, ensure_ascii=False))
    else:
        print(f"assistant-doctor · user {c.user} · version {c.conf.get('VERSION', 'not installed')}"
              + (" · offline" if c.offline else ""))
        for g, label in GROUPS:
            part = [r for r in rows if r["group"] == g]
            if not part:
                continue
            print(f"\n{label}")
            for r in part:
                print(f"  {SYMBOL[r['status']]} {r['id']:<16} {r['title']}" + (f" · {r['detail']}" if r["detail"] else ""))
                if r["status"] in ("fail", "warn", "offer", "unknown") and r["fix"]:
                    print(f"  {'':<19}→ {r['fix']}")
        print("\n" + " · ".join(f"{n} {SYMBOL[s].strip()}" for s, n in summary.items() if n))
    return 1 if summary["fail"] else 0


if __name__ == "__main__":
    sys.exit(main())
