# End of day + clean conversation for the assistant (installed as /etc/cron.d/assistant).
# Pick a time when you are asleep; the new conversation starts about 2-15 minutes later.
# cron's own PATH is only /usr/bin:/bin, and runuser lives in /usr/sbin.
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
45 5 * * * root /usr/local/sbin/assistant-daily-restart __USER__
