[Unit]
Description=Tell the assistant about new versions of itself and of its tools (it never updates without its owner's yes)
After=network-online.target assistant-wakeup.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/assistant-release-watch
StandardOutput=append:/var/log/assistant-release-watch.log
StandardError=append:/var/log/assistant-release-watch.log
