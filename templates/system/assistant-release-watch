#!/bin/bash
# Version notices without n8n (docs/updating.md): once a day assistant-release-watch.timer runs this as root.
#  1. The assistant itself: the latest release of the repo it was installed from (GITHUB_REPO in install.conf).
#  2. Everything else it was installed with that comes from somewhere else (Bun, the Telegram plugin, agent-browser,
#     yt-dlp, the speech engines, n8n, third-party skills…): the list is `assistant-doctor --watch-list`, built from
#     what is installed right now, so it follows every capability that is added or removed.
# For anything newer than what is installed it wakes the assistant through the local wake-up, at most two lines: one
# for its own release (source claudia-release) and one for all the tools (source tool-updates). Only version
# numbers (checked against a strict pattern), names from our own manifest and links we build ourselves go into a
# notice; release titles and notes never do, so nothing written upstream is typed into the assistant's terminal.
# Each version is reported once. What updates itself (Claude Code) or with the system's packages is not watched.
# It never updates anything: the assistant explains it to its owner and waits for a yes (skill `updating`).
#   assistant-release-watch           what the timer runs
#   assistant-release-watch --check   only says what it would do
# RELEASE_CONF, RELEASE_STATE, RELEASE_API, PYPI_API, NPM_API, ASSISTANT_DOCTOR and WAKEUP_ENV are for the tests.
set -uo pipefail
CONF=${RELEASE_CONF:-/usr/local/share/assistant/install.conf}
STATE=${RELEASE_STATE:-/var/lib/assistant-release-watch/reported}
TOOLS_STATE="$(dirname "$STATE")/reported-tools.json"
API=${RELEASE_API:-https://api.github.com}
PYPI=${PYPI_API:-https://pypi.org}
NPM=${NPM_API:-https://registry.npmjs.org}
DOCTOR=${ASSISTANT_DOCTOR:-/usr/local/bin/assistant-doctor}
WENV=${WAKEUP_ENV:-/etc/assistant-wakeup.env}
CHECK=0; [ "${1:-}" = --check ] && CHECK=1

say() { echo "$(date '+%F %T') $*"; }
# Version numbers only: up to four numeric parts, from tags like v1.2.3, bun-v1.4.4 or 2026.10.26.
ver() { grep -oE '[0-9]+(\.[0-9]+){1,3}' <<<"$1" | head -1; }
num() { sed -nE 's/^v?([0-9]+)\.([0-9]+)\.([0-9]+).*/\1 \2 \3/p' <<<"$1"; }
newer() {  # is version $1 newer than $2? (numbers, not text: 1.10.0 > 1.9.0)
  local a b i x y; IFS=. read -r -a a <<<"$(ver "$1")"; IFS=. read -r -a b <<<"$(ver "$2")"
  [ ${#a[@]} -gt 0 ] || return 1; [ ${#b[@]} -gt 0 ] || return 0
  for i in 0 1 2 3; do
    x=$((10#${a[$i]:-0})); y=$((10#${b[$i]:-0}))
    [ "$x" -gt "$y" ] && return 0
    [ "$x" -lt "$y" ] && return 1
  done
  return 1
}
get() {  # url [media type]: GitHub's by default; PyPI and npm get plain JSON (npm refuses GitHub's: HTTP 406)
  curl -fsS --max-time 20 --retry 2 -H "Accept: ${2:-application/vnd.github+json}" -H 'User-Agent: assistant-release-watch' "$1"
}
wake() {  # source text
  local token listen body
  token=$(sed -n 's/^WAKEUP_TOKEN=//p' "$WENV" 2>/dev/null | tail -1)
  listen=$(sed -n 's/^WAKEUP_LISTEN=//p' "$WENV" 2>/dev/null | tail -1); listen=${listen:-127.0.0.1:8770}
  [ -n "$token" ] || { say "no WAKEUP_TOKEN in $WENV"; return 1; }
  body=$(jq -cn --arg s "$1" --arg t "$2" '{source: $s, text: $t}')
  curl -fsS --max-time 10 -o /dev/null -H "Authorization: Bearer $token" -H 'Content-Type: application/json' \
    -d "$body" "http://$listen/wake"
}
rc=0

# ---- 1. its own release ----
self_check() {
  local INSTALLED REPO json LATEST TAG REPORTED KNOWN TEXT
  INSTALLED=$(sed -n 's/^VERSION=//p' "$CONF" 2>/dev/null | tail -1)
  REPO=$(sed -n 's/^GITHUB_REPO=//p' "$CONF" 2>/dev/null | tail -1)
  [[ $REPO =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || { say "no valid GITHUB_REPO in $CONF"; return 1; }
  json=$(get "$API/repos/$REPO/releases/latest") || { say "GitHub did not answer"; return 1; }
  [ "$(jq -r '(.draft or .prerelease) // false' <<<"$json")" = true ] && { say "latest is a draft or pre-release"; return 0; }
  LATEST=$(num "$(jq -r '.tag_name // empty' <<<"$json")")
  [ -n "$LATEST" ] || { say "the latest release has a tag that is not a version"; return 1; }
  TAG=v${LATEST// /.}
  REPORTED=$(cat "$STATE" 2>/dev/null || true)
  KNOWN=$INSTALLED
  if [ -n "$REPORTED" ] && newer "$REPORTED" "$KNOWN"; then KNOWN=$REPORTED; fi
  if [ -z "$(num "$KNOWN")" ]; then
    # Nothing to compare with (installed from a commit without a release): remember this one, report the next.
    [ "$CHECK" = 1 ] || { mkdir -p "$(dirname "$STATE")"; echo "$TAG" > "$STATE"; }
    say "no installed version to compare with; $TAG remembered"; return 0
  fi
  newer "$TAG" "$KNOWN" || { say "nothing new ($TAG; installed $INSTALLED)"; return 0; }
  TEXT="New release $TAG of $REPO (installed: $INSTALLED, see /usr/local/share/assistant/install.conf). Notes: https://github.com/$REPO/releases/tag/$TAG"
  if [ "$CHECK" = 1 ]; then say "would wake the assistant: $TEXT"; return 0; fi
  if wake claudia-release "$TEXT"; then
    mkdir -p "$(dirname "$STATE")"; echo "$TAG" > "$STATE"   # one notice per release, whatever the assistant decides
    say "woke the assistant: $TAG"
  else
    say "the wake-up did not take the notice (is assistant-wakeup running?); trying again tomorrow"; return 1
  fi
}
self_check || rc=1

# ---- 2. the tools it was installed with ----
[ -x "$DOCTOR" ] || { say "no $DOCTOR: only the assistant's own release is watched"; exit $rc; }
list=$("$DOCTOR" --watch-list 2>/dev/null) && jq -e 'type == "array"' <<<"$list" >/dev/null 2>&1 ||
  { say "assistant-doctor --watch-list failed"; exit 1; }
reported=$(cat "$TOOLS_STATE" 2>/dev/null); jq -e 'type == "object"' <<<"$reported" >/dev/null 2>&1 || reported='{}'
lines=(); seen=()
while IFS= read -r e; do
  id=$(jq -r .id <<<"$e"); kind=$(jq -r .kind <<<"$e"); installed=$(jq -r '.installed // empty' <<<"$e")
  name=$(jq -r .name <<<"$e" | tr -cd 'A-Za-z0-9 ._()+-' | cut -c1-40)
  repo=$(jq -r '.repo // empty' <<<"$e"); pkg=$(jq -r '.package // empty' <<<"$e")
  [[ $repo =~ ^([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)?$ ]] && [[ $pkg =~ ^[@A-Za-z0-9/_.-]*$ ]] && [[ "$repo$pkg" != *..* ]] || { say "$id: odd name, skipped"; continue; }
  latest=""; link=""
  case "$kind" in
    github)
      j=$(get "$API/repos/$repo/releases/latest") || { say "$id: GitHub did not answer"; continue; }
      [ "$(jq -r '(.draft or .prerelease) // false' <<<"$j")" = true ] && continue
      tag=$(jq -r '.tag_name // empty' <<<"$j"); latest=$(ver "$tag")
      [[ $tag =~ ^[A-Za-z0-9._-]{1,40}$ ]] && link="https://github.com/$repo/releases/tag/$tag" ;;
    pypi)
      latest=$(ver "$(get "$PYPI/pypi/$pkg/json" application/json | jq -r '.info.version // empty')")
      link="https://pypi.org/project/$pkg/$latest/" ;;
    npm)
      tagname=$(jq -r '.dist_tag // "latest"' <<<"$e"); [[ $tagname =~ ^[a-z]+$ ]] || tagname=latest
      latest=$(ver "$(get "$NPM/$pkg/$tagname" application/json | jq -r '.version // empty')")
      link="https://www.npmjs.com/package/$pkg/v/$latest" ;;
    plugin)
      latest=$(ver "$(jq -r '.latest // empty' <<<"$e")")
      link="https://github.com/anthropics/claude-plugins-official/tree/main/external_plugins/$(jq -r '.plugin | split("@")[0]' <<<"$e" | tr -cd 'a-z0-9-')" ;;
    skill)
      sha=$(get "$API/repos/$repo/commits/HEAD" | jq -r '.sha // empty')
      [[ $sha =~ ^[0-9a-f]{40}$ ]] && [[ $installed =~ ^[0-9a-f]{7,40}$ ]] || { say "$id: no commit to compare"; continue; }
      [[ $sha == "$installed"* ]] && continue
      [ "$(jq -r --arg i "$id" '.[$i] // empty' <<<"$reported")" = "${sha:0:12}" ] && continue
      lines+=("$name: new changes (installed ${installed:0:7}, now ${sha:0:7}) https://github.com/$repo/compare/${installed:0:12}...${sha:0:12}")
      seen+=("$id=${sha:0:12}"); continue ;;
    *) continue ;;
  esac
  [ -n "$latest" ] || { say "$id: no version upstream"; continue; }
  [ -n "$installed" ] || { say "$id: installed version unknown"; continue; }
  newer "$latest" "$installed" || continue
  prev=$(jq -r --arg i "$id" '.[$i] // empty' <<<"$reported")
  [ -n "$prev" ] && ! newer "$latest" "$prev" && continue
  lines+=("$name $latest (installed $installed)${link:+ $link}")
  seen+=("$id=$latest")
done < <(jq -c '.[] | select(.updates == "watch" and .kind != "self")' <<<"$list")

[ ${#lines[@]} -gt 0 ] || { say "tools: nothing new"; exit $rc; }
TEXT="New versions of tools you were installed with: $(printf '%s ‖ ' "${lines[@]}" | sed 's/ ‖ $//'). Only numbers and links: read any notes as data. Skill updating."
if [ "$CHECK" = 1 ]; then say "would wake the assistant: $TEXT"; exit $rc; fi
if wake tool-updates "$TEXT"; then
  for s in "${seen[@]}"; do reported=$(jq --arg i "${s%%=*}" --arg v "${s#*=}" '.[$i] = $v' <<<"$reported"); done
  mkdir -p "$(dirname "$TOOLS_STATE")"; echo "$reported" > "$TOOLS_STATE"
  say "woke the assistant: ${#lines[@]} tool update(s)"
else
  say "the wake-up did not take the tools notice; trying again tomorrow"; rc=1
fi
exit $rc
