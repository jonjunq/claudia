# Assistant settings, read by the scripts in bin/ (plain shell).
# Re-read at every restart of the session, so edits apply on the next restart.

# Model for the session: an alias (opus, sonnet) or a full model id.
# With --continue a resumed conversation keeps the model it was created with, so start.sh always passes it.
MODEL=opus

# Model for the nightly review of skills and memory (docs/memory.md). Empty = the same as MODEL.
REVIEW_MODEL=
# yes = a silent Telegram message after each nightly review that changed something. The summary is always in
# notes/last-review.md and the change in the git history.
REVIEW_NOTIFY=no

# tmux session that runs Claude Code (must match the systemd unit).
TMUX_SESSION=assistant

# Extra, self-built channels loaded as development channels (space-separated), e.g. "server:call".
# Leave empty if you only use the official Telegram plugin.
DEV_CHANNELS=

# Telegram chat that scripts (voice notes, permission watcher) send to.
# Empty = the first id in ~/.claude/channels/telegram/access.json (you, after pairing).
TELEGRAM_CHAT_ID=

# Optional voice features (bin/transcribe.sh, bin/speak.sh; docs/voice.md). Keys go in ~/.config/assistant/keys.env,
# not here. TRANSCRIBE_NAMES: names and words the cloud models tend to misspell, only names, comma-separated, e.g.
# "Ada, Proxmox, Jellyfin, n8n." (a whole sentence there sometimes leaks into the transcript).
TRANSCRIBE_NAMES=
# Local engines, used when the cloud ones fail: Parakeet (fast on a CPU) and faster-whisper (best-quality requests).
PARAKEET_VENV=$HOME/parakeet
TRANSCRIBE_LOCAL_MODEL=large-v3-turbo
WHISPER_VENV=$HOME/whisper
TTS_VOICE_ID=
TTS_LANGUAGE=en
TTS_SPEED=1.0
