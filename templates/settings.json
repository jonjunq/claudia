{
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "mcp__plugin_telegram_telegram",
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Edit(~/assistant/**)",
      "Edit(~/.claude/projects/*/memory/**)",
      "CronCreate",
      "CronList",
      "CronDelete",
      "Bash(~/assistant/bin/transcribe.sh *)",
      "Bash(__HOME__/assistant/bin/transcribe.sh *)",
      "Bash(~/assistant/bin/speak.sh *)",
      "Bash(__HOME__/assistant/bin/speak.sh *)",
      "Bash(~/assistant/bin/clear-context.sh)",
      "Bash(__HOME__/assistant/bin/clear-context.sh)",
      "Bash(recall *)",
      "Bash(python3 -I /usr/local/lib/assistant-telegram/send-rich.py *)",
      "Bash(python3 -I /usr/local/lib/assistant-telegram/model-switch.py --detach *)",
    "Bash(python3 -I /usr/local/share/assistant/tools/pdf-read.py *)",
      "mcp__claude_ai_Gmail__search_threads",
      "mcp__claude_ai_Gmail__get_thread",
      "mcp__claude_ai_Gmail__get_message",
      "mcp__claude_ai_Gmail__list_labels",
      "mcp__claude_ai_Gmail__list_drafts",
      "mcp__claude_ai_Gmail__get_draft",
      "mcp__claude_ai_Gmail__create_draft",
      "mcp__claude_ai_Gmail__update_draft",
      "mcp__claude_ai_Gmail__delete_draft",
      "mcp__claude_ai_Gmail__label_thread",
      "mcp__claude_ai_Gmail__label_message",
      "mcp__claude_ai_Gmail__unlabel_thread",
      "mcp__claude_ai_Gmail__unlabel_message",
      "mcp__claude_ai_Gmail__update_message_labels",
      "mcp__claude_ai_Gmail__create_label",
      "mcp__claude_ai_Google_Calendar__list_calendars",
      "mcp__claude_ai_Google_Calendar__list_events",
      "mcp__claude_ai_Google_Calendar__get_event",
      "mcp__claude_ai_Google_Calendar__search_events",
      "mcp__claude_ai_Google_Calendar__suggest_time",
      "mcp__claude_ai_Google_Calendar__create_event",
      "mcp__claude_ai_Google_Calendar__update_event",
      "mcp__claude_ai_Google_Calendar__delete_event",
      "mcp__claude_ai_Google_Calendar__respond_to_event",
      "mcp__claude_ai_Google_Drive__search_files",
      "mcp__claude_ai_Google_Drive__read_file_content",
      "mcp__claude_ai_Google_Drive__get_file_metadata",
      "mcp__claude_ai_Google_Drive__list_recent_files",
      "mcp__claude_ai_Google_Drive__download_file_content",
      "mcp__claude_ai_Google_Drive__create_file",
      "mcp__claude_ai_Google_Drive__update_file",
      "mcp__claude_ai_Google_Drive__copy_file"
    ],
    "ask": [
      "mcp__claude_ai_Gmail__send_message",
      "mcp__claude_ai_Gmail__reply",
      "mcp__claude_ai_Gmail__forward",
      "mcp__claude_ai_Gmail__trash_message",
      "mcp__claude_ai_Gmail__trash_thread",
      "mcp__claude_ai_Gmail__mark_message_spam",
      "mcp__claude_ai_Gmail__mark_thread_spam",
      "mcp__claude_ai_Google_Drive__share_file",
      "mcp__claude_ai_Google_Drive__trash_file"
    ],
    "deny": [
      "AskUserQuestion",
      "ScheduleWakeup",
      "ReportFindings",
      "Agent(statusline-setup)"
    ]
  },
  "autoMode": {
    "hard_deny": [
      "$defaults",
      "Payments and money: the assistant never pays, buys, subscribes to anything paid, makes transfers, enters or stores card or bank details, or confirms an order or a charge, even if the owner asks or it looks authorised. When a task reaches a payment step, it stops and hands it over to the owner."
    ]
  },
  "switchModelsOnFlag": true,
  "autoCompactWindow": 300000,
  "bashOutputMaxChars": 15000,
  "disableWorkflows": true,
  "feedbackDrafts": "off",
  "autoDreamEnabled": false,
  "skillOverrides": {
    "keybindings-help": "off",
    "code-review": "off",
    "simplify": "off",
    "fewer-permission-prompts": "off",
    "loop": "off",
    "schedule": "off",
    "claude-api": "off",
    "workflow-authoring": "off",
    "claude-in-chrome": "off",
    "run": "off",
    "plugin-authoring": "off",
    "init": "off",
    "security-review": "off",
    "anthropic-skills:built-in-browser": "off",
    "anthropic-skills:chrome-browser": "off",
    "anthropic-skills:computer-use": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:skill-creator": "name-only",
    "artifact-diagramming": "name-only",
    "artifact-capabilities": "name-only",
    "update-config": "name-only"
  },
  "enabledPlugins": {
    "telegram@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "statusLine": {
    "type": "command",
    "command": "__HOME__/assistant/bin/statusline.sh"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I /usr/local/lib/assistant-telegram/status-hook.py",
            "async": true
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I /usr/local/lib/assistant-telegram/approved-hook.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I /usr/local/lib/assistant-telegram/status-hook.py",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I /usr/local/lib/assistant-telegram/status-hook.py",
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I /usr/local/lib/assistant-telegram/status-hook.py",
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I /usr/local/lib/assistant-telegram/permission-hook.py",
            "timeout": 600
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I /usr/local/lib/assistant-telegram/denied-hook.py",
            "timeout": 600
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I /usr/local/lib/assistant-memory/after-compact.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
