# n8n settings (docs/n8n.md). Root and n8n only: it holds the encryption key. Restart after editing:
#   systemctl restart n8n
# Written by install-n8n.sh, which fills in the host, the time zone and a random encryption key.

# Where the editor and webhooks live. Default: this machine only (127.0.0.1). For your LAN, install with
# --listen 0.0.0.0 --host <this machine's LAN address>, and fence the port. Never expose it to the internet
# without a login layer in front (a reverse proxy with its own authentication, or a VPN).
N8N_HOST=__HOST__
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_LISTEN_ADDRESS=__LISTEN__
WEBHOOK_URL=http://__HOST__:5678/
N8N_EDITOR_BASE_URL=http://__HOST__:5678/
# Plain http on a local network: the login cookie cannot be marked Secure. Set to true behind https.
N8N_SECURE_COOKIE=false

# Encrypts the credentials stored in n8n. Keep a copy somewhere safe: without it a restored backup cannot
# decrypt its credentials.
N8N_ENCRYPTION_KEY=__ENCRYPTION_KEY__
N8N_USER_FOLDER=/var/lib/n8n
GENERIC_TIMEZONE=__TIMEZONE__
TZ=__TIMEZONE__

# Quiet: no telemetry, no version banners, no onboarding survey.
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_HIRING_BANNER_ENABLED=false
N8N_TEMPLATES_ENABLED=true

# Hardening. Several are already the default in n8n 2.x; they are set here so an update cannot change them.
N8N_RUNNERS_ENABLED=true
# Code nodes cannot read this file's variables (the encryption key, tokens).
N8N_BLOCK_ENV_ACCESS_IN_NODE=true
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_SKIP_AUTH_ON_OAUTH_CALLBACK=false
N8N_GIT_NODE_DISABLE_BARE_REPOS=true
# File nodes may only touch this folder.
N8N_RESTRICT_FILE_ACCESS_TO=/var/lib/n8n/files
# No node that runs shell commands, opens SSH sessions or watches local files: the assistant already has a shell
# of its own; n8n does not need one.
NODES_EXCLUDE=["n8n-nodes-base.executeCommand","n8n-nodes-base.localFileTrigger","n8n-nodes-base.ssh"]
# No community node packages: installing one runs third-party code inside n8n, and the MCP server offers a tool to
# do it. Turn on only if you need a specific package, and install it yourself.
N8N_COMMUNITY_PACKAGES_ENABLED=false
# Instance-level MCP (lets the assistant build and edit workflows, docs/n8n.md) is off until you enable it in
# Settings. To remove it completely: N8N_DISABLED_MODULES=mcp

# Old executions are deleted after 14 days.
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336
N8N_LOG_LEVEL=info
